# Samsung TV remote (existing)
USE_SAMSUNG_REMOTE=1
SAMSUNG_TV_IP=192.168.1.105
SAMSUNG_REMOTE_NAME=TVAutomation_2026
SAMSUNG_TV_PORT=8002
SAMSUNG_TV_TIMEOUT_MS=15000
SAMSUNG_TV_KEYS_DELAY_MS=120

# RMUS web UI login
RMUS_USERNAME=
RMUS_PASSWORD=

# RTDB topic source (--source=rtdb or npm run capture:rtdb)
# Same database URL as VITE_FIREBASE_DATABASE_URL in the app
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# Path shown in Simulator Editor (projects/{companySlug}/{projectSlug})
RTDB_PROJECT_PATH=projects/your-company/your-simulator
# Path to Firebase service account JSON (download from Firebase console)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
# Optional: only run specific groups (comma-separated)
# RTDB_TOPIC_GROUPS=g_2,g_3
